    {
      "name": "ace_badge_v13",
      "path": "localization/en/ace_badge_v13.json",
      "resource_type": "deck_builder_badge",
      "format": "json_records",
      "records_path": "records",
      "id_field": "id",
      "text_fields": {
        "label": "label"
      },
