    {
      "name": "v13_maintenance_dialogue",
      "path": "localization/en/v13_maintenance.json",
      "resource_type": "story_maintenance",
      "format": "json_mapping",
      "records_path": "dialogue",
      "id_field": "$key",
      "text_fields": {
        "replacement": "replacement"
      },
      "source_fields": {
        "replacement": "source"
      },
