    {
      "name": "wait_title_ui82",
      "path": "localization/en/wait_title_ui82.json",
      "resource_type": "ui_wait_string",
      "format": "json_mapping",
      "records_path": "strings",
      "id_field": "$key",
      "text_fields": {
        "text": "$value"
      },
      "expected_count": 1
